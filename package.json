{
  "name": "worm-bin-logbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:rules": "firebase emulators:exec --only firestore --project demo-wormlog \"vitest run tests/rules\"",
    "icons": "pwa-assets-generator",
    "deploy": "npm test && vite build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "firebase-tools": "^15.34.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
